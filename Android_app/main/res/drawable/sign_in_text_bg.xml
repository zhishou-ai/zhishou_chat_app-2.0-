<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 设置圆角半径 -->
    <corners android:radius="3dp" />

    <!-- 设置边框 -->
    <stroke
        android:width="1.5dp"
        android:color="#CEC7C5" /> <!-- 边框颜色 -->

    <!-- 设置背景填充色（可选） -->
    <solid android:color="#FFFFFF" /> <!-- 内部背景 -->
</shape>