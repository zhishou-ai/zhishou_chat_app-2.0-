<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 设置背景色 -->
    <solid android:color="@color/main_color_bg"/> <!-- 替换成你的颜色 -->

    <!-- 设置圆角半径 -->
    <corners android:radius="16dp" /> <!-- 数值越大越圆 -->

    <!-- 可选：内边距 -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp" />
</shape>